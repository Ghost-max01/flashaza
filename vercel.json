{
  "version": 2,
  "builds": [
    {
      "src": "api/router.php",
      "use": "vercel-php@0.8.0"
    }
  ],
  "functions": {
    "api/router.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "routes": [
    {
      "src": "^/css/(.*)$",
      "dest": "/css/$1"
    },
    {
      "src": "^/js/(.*)$",
      "dest": "/js/$1"
    },
    {
      "src": "^/images/(.*)$",
      "dest": "/images/$1"
    },
    {
      "src": "^/sound/(.*)$",
      "dest": "/sound/$1"
    },
    {
      "src": "^/json/(.*)$",
      "dest": "/json/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/router.php"
    }
  ]
}
