# Local uploads (run-time files, not part of the source)
profile/
request/

# Log files
error_log
error_log.txt
*.log

# Archives & Setup files
*.zip
supabase_init.sql
supabase_setup.sh

# CRITICAL: Prevent Vercel from auto-detecting extra PHP functions.
# Exclude API subdirectories that might contain auto-detectable PHP files
api/Admin-Maxwell/
api/PHPMailer/
api/css/
api/images/
api/js/
api/json/
api/sound/

# Root-level front controller (not needed; router handles all routes)
/index.php

# Placeholder PHP files in root static directories
css/**/*.php
images/**/*.php
js/**/*.php
json/**/*.php
sound/**/*.php

# IDE / System directories
.gemini/
.DS_Store
.git/
.gitignore

# Development & Build files
node_modules/
package-lock.json
