# Local uploads (run-time files, not part of the source)
profile/
request/

# Log files
error_log
error_log.txt
*.log

# Archives & Setup files
*.zip
supabase_init.sql
supabase_setup.sh

# Prevent Vercel from auto-detecting individual PHP files as separate functions.
# All requests route through api/router.php (defined in vercel.json).
# Keep app/ PHP sources for the single router function, but exclude placeholder PHP files.
api/**
!api/router.php
index.php
css/**/*.php
js/**/*.php
images/**/*.php
json/**/*.php
sound/**/*.php

# IDE / System directories
.gemini/
.DS_Store
.git/
.gitignore

# Development & Build files
node_modules/
package-lock.json

# Do NOT exclude these - they're needed for static file serving
# css/
# js/
# images/
# json/
# sound/
