# Local uploads (run-time files, not part of the source)
profile/
request/

# Log files
error_log
error_log.txt
*.log

# Archives & Setup files
*.zip
supabase_init.sql
supabase_setup.sh

# CRITICAL: Prevent Vercel from auto-detecting multiple PHP functions.
# Exclude ALL PHP files globally, then whitelist only api/router.php and api/app/
**/*.php

# Whitelist the single router function and its app sources
!api/router.php
!api/app/**

# IDE / System directories
.gemini/
.DS_Store
.git/
.gitignore

# Development & Build files
node_modules/
package-lock.json
