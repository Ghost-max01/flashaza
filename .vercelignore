# Local uploads (run-time files, not part of the source)
profile/
request/

# Log files
error_log
error_log.txt
*.log

# Archives & Setup files
*.zip
supabase_init.sql
supabase_setup.sh

# CRITICAL: Prevent Vercel from auto-detecting multiple PHP functions.
# Explicitly exclude all PHP files except router.php
# Exclude All directories containing PHP files that are not our single router function
api/Admin-Maxwell/
api/PHPMailer/
api/css/
api/images/
api/js/
api/json/
api/sound/

# Exclude ALL .php files globally
**/*.php

# Whitelist ONLY api/router.php and api/app/ tree
!api/router.php
!api/app/
